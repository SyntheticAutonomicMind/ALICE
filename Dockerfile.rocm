#
# ALICE Dockerfile - AMD ROCm variant (ROCm 10.0.0)
#
# Uses the official AMD ROCm 10.0.0 base image, which includes
# PyTorch 2.13.0+rocm10.0.0 with multi-arch device support for all
# supported AMD GPUs (including gfx1103 Phoenix and gfx1151 Strix Halo).
#
# Build:
#   docker build -f Dockerfile.rocm -t alice:rocm .
#
# Run:
#   docker run --device=/dev/kfd --device=/dev/dri \
#     --group-add video --group-add render \
#     -p 8080:8080 -v alice-models:/data/models \
#     alice:rocm

ARG PYTHON_VERSION=3.13
ARG TORCH_VERSION=2.13.0+rocm10.0.0
ARG TORCHVISION_VERSION=0.28.0+rocm10.0.0
ARG TORCHAUDIO_VERSION=2.11.0.2+rocm10.0.0

# =============================================================================
# Stage 1: Builder
# =============================================================================
FROM rocm/dev-ubuntu-24.04:10.0.0-full AS builder

ARG PYTHON_VERSION
ARG TORCH_VERSION
ARG TORCHVISION_VERSION
ARG TORCHAUDIO_VERSION

# Install Python 3.13 from deadsnakes PPA (Ubuntu 24.04 only ships 3.12).
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && rm -rf /var/lib/apt/lists/* && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    python${PYTHON_VERSION} \
    python${PYTHON_VERSION}-venv \
    python${PYTHON_VERSION}-dev \
    python3-pip \
    git \
    && rm -rf /var/lib/apt/lists/*

# Use the specified Python version
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python${PYTHON_VERSION} 1

WORKDIR /build

# Install PyTorch with ROCm 10.0.0 support (multi-arch, device-all).
# The ROCm pip packages include GPU-specific device code and runtime
# libraries automatically — no separate ROCm install is needed.
# device-all covers gfx1103 (Phoenix), gfx1151 (Strix Halo),
# RDNA2/RDNA3/CDNA, and all other supported AMD GPUs.
# Use python3 -m pip to avoid issues with Debian-managed pip that
# can't be upgraded (RECORD file not found).
RUN python3 -m ensurepip --upgrade && \
    python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir \
    --index-url https://stable.repo.amd.com/rocm/whl-next/ \
    "torch[device-all]==${TORCH_VERSION}" \
    "torchvision[device-all]==${TORCHVISION_VERSION}" \
    "torchaudio==${TORCHAUDIO_VERSION}"

# Install remaining dependencies.
# PIP_CONSTRAINT: pins setuptools<81 for build isolation environments
# (setuptools 81+ removed pkg_resources, needed at build time by some packages).
# stable-audio-tools is installed with --no-deps because its dynamic metadata
# pulls in flash-attn>=2.5.0 (requires CUDA_HOME to build) and pandas==2.0.2
# (no Python 3.13 wheel). We install it separately, then install the
# remaining requirements which override pandas with a newer version.
COPY requirements.txt .
RUN echo "setuptools<81" > /build/constraints.txt && \
    PIP_CONSTRAINT=/build/constraints.txt pip install --no-cache-dir --no-deps stable-audio-tools && \
    PIP_CONSTRAINT=/build/constraints.txt pip install --no-cache-dir $(grep -vE "^#|^$|^stable-audio-tools" requirements.txt)

# =============================================================================
# Stage 2: Runtime
# =============================================================================
FROM rocm/dev-ubuntu-24.04:10.0.0-full AS runtime

ARG PYTHON_VERSION

LABEL org.opencontainers.image.title="ALICE (ROCm 10.0.0)"
LABEL org.opencontainers.image.description="ALICE - Remote Stable Diffusion Service with AMD ROCm 10.0.0 GPU support"
LABEL org.opencontainers.image.url="https://github.com/SyntheticAutonomicMind/ALICE"
LABEL org.opencontainers.image.source="https://github.com/SyntheticAutonomicMind/ALICE"
LABEL org.opencontainers.image.licenses="GPL-3.0-only"

# Install Python 3.13 from deadsnakes PPA (Ubuntu 24.04 only ships 3.12).
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    && rm -rf /var/lib/apt/lists/* && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    python${PYTHON_VERSION} \
    python3-pip \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python${PYTHON_VERSION} 1

# Create non-root user (with video/render group for GPU access)
RUN groupadd -r alice && \
    getent group video || groupadd -r video && \
    getent group render || groupadd -r render && \
    useradd -r -g alice -G video,render -d /app -s /sbin/nologin alice

# Copy Python packages from builder.
# Copy the entire Python lib directory to handle patch-versioned paths
# (e.g., python3.13 vs python3.13.15).
COPY --from=builder /usr/local/lib/python${PYTHON_VERSION} /usr/local/lib/python${PYTHON_VERSION}
COPY --from=builder /usr/local/bin /usr/local/bin

WORKDIR /app
RUN mkdir -p /data/models /data/images /data/logs /data/data /data/auth /config

# Copy application code
COPY src/ /app/src/
COPY web/ /app/web/
COPY requirements.txt /app/

# Copy default config
COPY docker/config.docker.yaml /config/config.yaml

# Set ownership
RUN chown -R alice:alice /app /data /config

# Environment
ENV ALICE_CONFIG=/config/config.yaml
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# ROCm environment (AMD GPU stability)
ENV PYTORCH_ALLOC_CONF=expandable_segments:True
ENV MIOPEN_DEBUG_FIND_ALL=0

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -sf http://localhost:8080/livez || exit 1

EXPOSE 8080

USER alice

CMD ["python3", "-m", "src.main"]
